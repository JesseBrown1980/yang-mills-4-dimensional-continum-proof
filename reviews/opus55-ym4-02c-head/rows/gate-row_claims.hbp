LAT_TREE|lines=285-300|src='    def tree(self):\n        # BFS tree over sites using forward links, one link per non-origin site\n        seen = {self.sites[0]}\n        q = [self.sites[0]]\n        tr = []\n        while q:\n            n = []\n            for x in q:\n                for mu in range(self.k):\n                    y = self.step(x, mu)\n                    if y not in seen:\n                        seen.add(y)\n                        tr.append(self.lid[(x, mu)])\n                        n.append(y)\n            q = n\n        return tr'|json=0
